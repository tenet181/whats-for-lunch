.page {
  min-height: 100vh;
  padding-bottom: calc(96rpx + env(safe-area-inset-bottom));
}

/* 顶部 */
.header {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(250, 247, 240, 0.95);
  border-bottom: 1rpx solid #e7e5e4;
  padding: 24rpx 32rpx 16rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
}
.subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #78716c;
}
.tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #78716c;
}
.tab-active {
  background: #292524;
  color: #faf7f0;
}

/* 地图 */
.map-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border: 1rpx solid #e7e5e4;
  border-radius: 32rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.map-canvas {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 50%; /* 680:340 */
  background: #fdfcf9;
  border-radius: 24rpx;
  overflow: hidden;
}
.center-dot {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.center-pulse {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #c2410c;
  box-shadow: 0 0 0 8rpx rgba(194, 65, 12, 0.15);
}
.center-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #78716c;
  white-space: nowrap;
}
.dot {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
}
.dot-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #292524;
  color: #faf7f0;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dot-far .dot-num {
  background: transparent;
  border: 2rpx dashed #a8a29e;
  color: #78716c;
}
.dot-label {
  margin-top: 2rpx;
  font-size: 16rpx;
  color: #57534e;
  white-space: nowrap;
  transform: scale(0.85);
}
.legend {
  display: flex;
  gap: 24rpx;
  padding: 16rpx 40rpx 0;
  font-size: 22rpx;
  color: #78716c;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.legend-solid {
  background: #292524;
}
.legend-hollow {
  border: 2rpx dashed #a8a29e;
}
.alert {
  margin: 20rpx 32rpx 0;
  border: 1rpx solid #fcd34d;
  background: #fffbeb;
  color: #92400e;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 列表 */
.filter-scroll {
  white-space: nowrap;
  padding: 24rpx 32rpx 0;
}
.filter-row {
  display: inline-flex;
  gap: 16rpx;
}
.filter-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d6d3d1;
  color: #57534e;
  font-size: 24rpx;
  font-weight: 500;
}
.filter-active {
  background: #292524;
  color: #faf7f0;
  border-color: #292524;
}
.list {
  padding: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.card {
  background: #fff;
  border: 1rpx solid #e7e5e4;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.card-id {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  border-radius: 50%;
  background: #292524;
  color: #faf7f0;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card-id-far {
  background: transparent;
  border: 2rpx dashed #a8a29e;
  color: #78716c;
}
.card-name {
  font-size: 30rpx;
  font-weight: 500;
}
.card-warn {
  font-size: 24rpx;
}
.card-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.tag {
  background: #fff7ed;
  color: #9a3412;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}
.tag-big {
  background: #ffedd5;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}
.card-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a8a29e;
  line-height: 1.5;
}

/* 抽一家 */
.picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx 0;
}
.picker-tip {
  font-size: 28rpx;
  color: #78716c;
}
.picker-box {
  margin-top: 64rpx;
  width: 100%;
  height: 320rpx;
  background: #fff;
  border: 1rpx solid #e7e5e4;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.picker-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #292524;
}
.picker-winner {
  color: #c2410c;
}
.picker-sig {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #78716c;
}
.picker-emoji {
  font-size: 72rpx;
}
.picker-btn {
  margin-top: 64rpx;
  width: 100%;
  background: #c2410c;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 32rpx;
  padding: 8rpx 0;
}
.picker-btn[disabled] {
  opacity: 0.6;
}
.picker-count {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #a8a29e;
}

/* 详情弹层 */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #faf7f0;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(40%); }
  to { transform: translateY(0); }
}
.sheet-grip {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d6d3d1;
  margin: 0 auto 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.sheet-id {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #292524;
  color: #faf7f0;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-name {
  font-size: 36rpx;
  font-weight: 600;
}
.sheet-drive {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #78716c;
}
.sheet-addr {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #fff;
  border: 1rpx solid #e7e5e4;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}
.sheet-addr-copied {
  border-color: #86efac;
  background: #f0fdf4;
}
.sheet-addr-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #57534e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sheet-addr-btn {
  flex: none;
  font-size: 24rpx;
  font-weight: 500;
  color: #c2410c;
}
.sheet-addr-copied .sheet-addr-btn {
  color: #16a34a;
}
.sheet-tags {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sheet-note {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #57534e;
  line-height: 1.7;
}
.sheet-alert {
  margin-top: 24rpx;
  border: 1rpx solid #fcd34d;
  background: #fffbeb;
  color: #92400e;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.sheet-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 24rpx;
  padding: 8rpx 0;
}
.btn-dark {
  background: #292524;
  color: #faf7f0;
}
.btn-dp {
  background: #ff6633;
  color: #fff;
}
